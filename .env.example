# Example variable names ONLY — no real values, credentials, or student data.
# Store actual values in a private local environment or hosting secret manager.
# DATABASE_URL=postgresql://<private-user>:<private-password>@<private-host>/attendify?sslmode=require
# PUBLIC_ORIGIN=https://your-domain.example
# NODE_ENV=production
# ATTENDANCE_ENABLED=0
# ROSTER_ENABLED=0  # may enable lecturer roster UI/API without enabling QR check-in
# ATTENDANCE_QR_SECRET=<32+-bytes-of-high-entropy-secret>
# ATTENDANCE_DEVICE_KEY=<another-independent-32+-bytes-of-high-entropy-secret>
# PORT=3000

# PRIVATE import script (outside Git repo, no real examples):
# IMPORT_FILE=/private/roster/students.json
# IMPORT_COURSE_ID=<existing-course-uuid>
# IMPORT_LECTURER_ID=<lecturer-assigned-to-course-uuid>
